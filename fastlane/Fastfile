# frozen_string_literal: true

require "shellwords"

# Peelco iOS Fastfile — keep only lanes for enabled modules.
# Never hardcode ASC key IDs; use env or gitignored fastlane/AuthKey_<KEY_ID>.p8
#
# Env:
#   APP_STORE_CONNECT_KEY_ID / ISSUER_ID / KEY_PATH or KEY (base64)
#   FASTLANE_RUN_XCODEGEN=1  — run xcodegen before build/screenshots
#   CHANGELOG — TestFlight notes
#   VERSION_CODE — CI build number (optional; set CURRENT_PROJECT_VERSION)

# App Store Connect credentials follow the GitLab group convention: the
# base64 .p8 arrives as APPSTORE_CONNECT_API_KEY and CI writes it to
# fastlane/AuthKey_<KEY_ID>.p8. See another app for the same wiring.
ASC_DEFAULT_KEY_ID = "REDACTED"
ASC_DEFAULT_ISSUER_ID = "REDACTED"
# Must match `fastlane/Appfile`'s `team_id`, and the DEVELOPMENT_TEAM in
# project.yml. When they disagree, the archive builds under one team and
# `exportArchive` looks for profiles under the other, which fails with
# "No Account for Team" and "No profiles for <bundle id> were found" — the
# archive step itself succeeds, so the mismatch only shows up at export.
TEAM_ID = ENV.fetch("APPLE_TEAM_ID", "YCFL9S5UA8")

def asc_key_id
  ENV["APP_STORE_CONNECT_KEY_ID"] || ENV["APPSTORE_CONNECT_API_KEY_ID"] || ASC_DEFAULT_KEY_ID
end

def asc_issuer_id
  ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["APPSTORE_CONNECT_API_KEY_ISSUER_ID"] || ASC_DEFAULT_ISSUER_ID
end

def asc_key_path
  ENV["APP_STORE_CONNECT_KEY_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
    File.expand_path("AuthKey_#{asc_key_id}.p8", __dir__)
end

# -allowProvisioningUpdates cannot create or fetch profiles without an
# authenticated account, so xcodebuild needs the key passed through directly.
def xcode_api_auth_args
  return "-allowProvisioningUpdates" unless File.exist?(asc_key_path)

  [
    "-allowProvisioningUpdates",
    "-authenticationKeyID", Shellwords.escape(asc_key_id),
    "-authenticationKeyIssuerID", Shellwords.escape(asc_issuer_id),
    "-authenticationKeyPath", Shellwords.escape(asc_key_path)
  ].join(" ")
end

# The runner's login keychain is locked in headless sessions; signing fails
# with no useful message until it is unlocked.
def prepare_ci_keychain
  return unless is_ci && ENV["KEYCHAIN_PASSWORD"]

  unlock_keychain(
    path: File.expand_path("~/Library/Keychains/login.keychain-db"),
    password: ENV["KEYCHAIN_PASSWORD"]
  )
end

def signed_export_options
  { signingStyle: "automatic", teamID: TEAM_ID }
end

def load_asc_api_key
  key_id = asc_key_id
  issuer_id = asc_issuer_id
  # Group convention: APPSTORE_CONNECT_API_KEY carries the base64 .p8.
  content = ENV["APP_STORE_CONNECT_KEY"] || ENV["APPSTORE_CONNECT_API_KEY"]
  path = asc_key_path

  opts = { key_id: key_id, issuer_id: issuer_id, in_house: false }
  if File.exist?(path)
    opts[:key_filepath] = path
  elsif !content.to_s.empty?
    opts[:key_content] = content
    opts[:is_key_content_base64] = true
  else
    UI.important("No App Store Connect API key found (APPSTORE_CONNECT_API_KEY or #{path}). Falling back to interactive auth.")
    return nil
  end

  app_store_connect_api_key(**opts)
end

def apply_ci_build_number
  return unless ENV["VERSION_CODE"].to_s.length.positive?

  increment_build_number(
    build_number: ENV["VERSION_CODE"],
    xcodeproj: "Jolt.xcodeproj"
  )
end

# fastlane's `sh` runs commands from fastlane/, not the repo root, so anything
# resolving a repo-relative path (project.yml, .swiftlint.yml) has to chdir first.
def sh_at_root(*args, **kwargs)
  Dir.chdir(File.expand_path("..", __dir__)) do
    sh(*args, **kwargs)
  end
end

default_platform(:ios)

platform :ios do
  before_all do
    ENV["APP_IDENTIFIER"] ||= "cz.peelco.jolt"
  end

  desc "Regenerate Xcode project with XcodeGen"
  lane :generate_project do
    sh_at_root("xcodegen", "--spec", "project.yml")
  end

  desc "Run SwiftLint"
  lane :lint do
    sh_at_root("swiftlint", "--strict")
  end

  # --- tests (include when unit/UI tests exist) ---
  desc "Run tests on simulator"
  lane :test_dev do
    run_tests(
      scheme: "Jolt",
      project: "Jolt.xcodeproj",
      derived_data_path: "DerivedData",
      destination: ENV.fetch("FASTLANE_SIMULATOR", "platform=iOS Simulator,name=iPhone 17")
    )
  end

  desc "Build Debug development IPA"
  lane :build_dev do
    generate_project if ENV["FASTLANE_RUN_XCODEGEN"] == "1"
    apply_ci_build_number
    gym(
      project: "Jolt.xcodeproj",
      scheme: "Jolt",
      configuration: "Debug",
      # Validation only needs to prove the app compiles. Signing it would
      # require a registered App ID and a team certificate on the runner,
      # which would make an unrelated account problem fail the build.
      skip_package_ipa: true,
      destination: "generic/platform=iOS Simulator",
      output_directory: "build/dev",
      clean: true
    )
  end

  desc "CI validation: lint + test + dev build"
  lane :dev do
    lint
    test_dev
    build_dev
  end

  desc "Build Release IPA for App Store / TestFlight"
  lane :build do
    prepare_ci_keychain
    generate_project if ENV["FASTLANE_RUN_XCODEGEN"] == "1"
    apply_ci_build_number
    gym(
      project: "Jolt.xcodeproj",
      scheme: "Jolt",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/prod",
      output_name: "Jolt-prod.ipa",
      clean: true,
      xcargs: xcode_api_auth_args,
      export_options: signed_export_options
    )
  end

  # MODULE: internal
  desc "Build Release ad-hoc IPA for internal distribution"
  lane :build_internal do
    prepare_ci_keychain
    generate_project if ENV["FASTLANE_RUN_XCODEGEN"] == "1"
    apply_ci_build_number
    gym(
      project: "Jolt.xcodeproj",
      scheme: "Jolt",
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "build/internal",
      output_name: "Jolt-internal.ipa",
      clean: true,
      xcargs: xcode_api_auth_args,
      export_options: signed_export_options
    )
  end

  desc "Internal distribution flow"
  lane :internal do
    lint
    test_dev
    build_internal
  end
  # END MODULE: internal

  # MODULE: testflight
  desc "Upload IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa = options[:ipa] || lane_context[SharedValues::IPA_OUTPUT_PATH] || "build/prod/Jolt-prod.ipa"
    UI.user_error!("No IPA at #{ipa}. Run build first.") unless ipa && File.exist?(ipa)

    upload_params = {
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false,
      changelog: ENV["CHANGELOG"] || "Automated build"
    }
    key = load_asc_api_key
    upload_params[:api_key] = key if key
    upload_to_testflight(**upload_params)
  end

  desc "Build Release and upload to TestFlight"
  lane :beta do
    build
    upload_testflight
  end

  desc "CI TestFlight lane (alias)"
  lane :testflight do
    beta
  end
  # END MODULE: testflight


  # MODULE: screenshots
  desc "Capture App Store screenshots, then flatten alpha"
  lane :screenshots do
    generate_project if ENV["FASTLANE_RUN_XCODEGEN"] == "1"
    capture_screenshots
    flatten_screenshots
  end

  private_lane :flatten_screenshots do
    unless system("command -v magick > /dev/null 2>&1")
      UI.user_error!("ImageMagick required. Install: brew install imagemagick")
    end
    screenshots_root = File.expand_path("screenshots", __dir__)
    pngs = Dir.glob(File.join(screenshots_root, "**", "*.png")).reject { |f| File.basename(f).start_with?(".") }
    if pngs.empty?
      UI.important("No PNG screenshots under #{screenshots_root}")
      next
    end
    pngs.each do |path|
      tmp = "#{path}.flat.png"
      sh("magick", path, "-background", "white", "-alpha", "remove", "-alpha", "off", tmp, log: false)
      FileUtils.mv(tmp, path)
    end
    UI.success("Flattened #{pngs.size} screenshot(s).")
  end

  desc "Upload screenshots only to App Store Connect"
  lane :upload_screenshots do
    deliver_params = {
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      screenshots_path: File.expand_path("screenshots", __dir__)
    }
    key = load_asc_api_key
    deliver_params[:api_key] = key if key
    upload_to_app_store(**deliver_params)
  end
  # END MODULE: screenshots

  # MODULE: metadata
  desc "Upload text metadata from fastlane/metadata"
  lane :upload_metadata do
    deliver_params = {
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      metadata_path: File.expand_path("metadata", __dir__)
    }
    key = load_asc_api_key
    deliver_params[:api_key] = key if key
    upload_to_app_store(**deliver_params)
  end
  # END MODULE: metadata

  # MODULE: screenshots + metadata
  desc "Capture screenshots, flatten, upload screenshots + metadata"
  lane :store_assets do
    screenshots
    upload_screenshots
    upload_metadata
  end
  # END MODULE: screenshots + metadata
end

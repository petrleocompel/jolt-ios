<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>Jolt</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance, declared here so App Store Connect stops asking on
	     every TestFlight build. False is accurate: the app ships no encryption
	     of its own. It uses HTTPS via URLSession and the keychain via the
	     Security framework, both of which are encryption provided by the
	     operating system and exempt under Apple's rules.

	     Must be a real boolean. A <string>NO</string> here is truthy to App
	     Store Connect and it will keep prompting.

	     If Apple ever does require documentation, they issue a code that goes
	     alongside this as ITSEncryptionExportComplianceCode. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Jolt uses Bluetooth to find, pair, and control your Pavlok device.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Jolt uses Bluetooth to find, pair, and control your Pavlok device.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Jolt uses notifications for alarms and device alerts.</string>
	<key>NSCameraUsageDescription</key>
	<string>Jolt uses the camera to scan a QR code to dismiss an alarm.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
